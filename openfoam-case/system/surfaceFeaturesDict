FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      surfaceFeaturesDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

surfaces ("porousUnitLattice.stl");

// Identify a feature when angle between faces < includedAngle
includedAngle   150;

// Do not mark region edges
geometricTestOnly yes;

// Write obj files for visualization
writeObj        yes;

